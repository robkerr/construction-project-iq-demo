# Copy this file to .env and fill in the values. .env is git-ignored (never commit secrets).
# Keys are grouped by phase; each script reads only what it needs.

# ============================ Fabric / workspace ============================
# Your existing Fabric workspace (on an F2+ / trial capacity). Scripts create items inside it.
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_CAPACITY_ID=
FABRIC_LAKEHOUSE_NAME=lh_project_intelligence
# Written by scripts/10_provision_fabric.ps1 after it creates/reuses the Lakehouse:
FABRIC_LAKEHOUSE_ID=
FABRIC_API_BASE=https://api.fabric.microsoft.com/v1

# ============================ Azure / Entra ============================
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=westus3
AZURE_RESOURCE_GROUP=rg-project-iq-demo

# ============================ Service principal (setup_spn.ps1) ============================
# setup_spn.ps1 creates the SPN, grants it workspace Admin, and writes these back.
SPN_APP_ID=
SPN_TENANT_ID=
SPN_CLIENT_SECRET=            # secret — never commit
SPN_DISPLAY_NAME=sp-project-iq-fabric-demo

# ============================ Data generation ============================
DATA_SEED=42

# ============================ Semantic model (Phase 3, portal/manual) ============================
SEMANTIC_MODEL_NAME=ProjectControlsIQ
# Written by scripts/30_deploy_semantic_model.ps1 after it creates/reuses the model:
SEMANTIC_MODEL_ID=

# ============================ Power BI reports (Phase 5) ============================
# Written by scripts/31_deploy_report.ps1. Story 1 = Portfolio Schedule Risk (default keys);
# Story 2 = Bid Evaluation (TBE/CBE), deployed with -ReportIdKey BID_REPORT_ID -ReportNameKey BID_REPORT_NAME.
REPORT_ID=
REPORT_NAME=ProjectControlsIQ
BID_REPORT_ID=
BID_REPORT_NAME=BidEvaluationIQ

# ============================ Azure AI Search (Phase 4) ============================
AI_SEARCH_ENDPOINT=
AI_SEARCH_CONNECTION_NAME=ProjectKnowledge
AI_SEARCH_INDEX=project-knowledge
# Optional admin key for search/build_index.py. Prefer RBAC (Search Index Data Contributor);
# leave blank to use your Entra identity.
AI_SEARCH_ADMIN_KEY=
# Optional embeddings deployment for vector/hybrid search:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# ============================ Fabric Data Agent (structured grounding) ============================
DATA_AGENT_NAME=ProjectControlsIQAgent
DATA_AGENT_ARTIFACT_ID=
# MCP endpoint has a "/mcp/" segment and ends in "/agent":
#   https://api.fabric.microsoft.com/v1/mcp/workspaces/{FABRIC_WORKSPACE_ID}/dataagents/{DATA_AGENT_ARTIFACT_ID}/agent
DATA_AGENT_MCP_ENDPOINT=

# ============================ Azure AI Foundry agent (Phase 6) ============================
# gpt-4.1 must be deployed on the project's account (Agent Service Fabric/AI Search tools are
# not supported on gpt-5 in some regions — use gpt-4.1 or gpt-4o).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-4.1
FABRIC_CONNECTION_NAME=ProjectControlsIQAgent

# ============================ M365 Copilot surface (Phase 6) ============================
# Declarative agent / Copilot Studio surface (agent/m365_copilot.md).
M365_DECLARATIVE_AGENT_NAME=Project Controls Assistant
