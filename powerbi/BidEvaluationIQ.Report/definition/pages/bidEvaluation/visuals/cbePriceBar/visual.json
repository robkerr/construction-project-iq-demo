{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json",
  "name": "cbePriceBar",
  "position": {
    "x": 648,
    "y": 168,
    "z": 0,
    "width": 616,
    "height": 232,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_bid"
                    }
                  },
                  "Property": "supplier_name"
                }
              },
              "queryRef": "fact_bid.supplier_name",
              "nativeQueryRef": "supplier_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_bid"
                    }
                  },
                  "Property": "Quoted Price"
                }
              },
              "queryRef": "fact_bid.Quoted Price",
              "nativeQueryRef": "Quoted Price"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_bid"
                    }
                  },
                  "Property": "Evaluated Price"
                }
              },
              "queryRef": "fact_bid.Evaluated Price",
              "nativeQueryRef": "Evaluated Price"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "fact_bid"
                  }
                },
                "Property": "Evaluated Price"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'CBE \u00b7 Quoted vs Evaluated price by supplier'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}