table fact_bid

	/// Number of supplier bids in context (across the selected RFQ/category/project).
	measure 'Bid Count' = COUNTROWS(fact_bid)
		formatString: #,##0

	/// CBE: quoted base price summed in context (at supplier grain = that bid's quote).
	measure 'Quoted Price' = SUM(fact_bid[quoted_price])
		formatString: $#,##0

	/// CBE: normalized evaluated price summed in context (at supplier grain = that bid's evaluated cost, incl. disqualified bids).
	measure 'Evaluated Price' = SUM(fact_bid[evaluated_price])
		formatString: $#,##0

	/// TBE: bids that passed technical evaluation (no mandatory exception, score >= 70).
	measure 'Qualified Bids' = CALCULATE(COUNTROWS(fact_bid), fact_bid[is_technically_qualified] = TRUE())
		formatString: #,##0

	/// TBE: technically non-compliant bids (excluded from commercial ranking).
	measure 'Disqualified Bids' = CALCULATE(COUNTROWS(fact_bid), fact_bid[is_technically_qualified] = FALSE())
		formatString: #,##0

	/// TBE: average weighted technical compliance score (0-100) of bids in context.
	measure 'Avg Technical Score' = AVERAGE(fact_bid[technical_score])
		formatString: #,##0.0

	/// TBE: total number of technical deviations across bids in context.
	measure 'Technical Deviations' = SUM(fact_bid[tech_deviation_count])
		formatString: #,##0

	/// CBE: lowest quoted base price received (may be a disqualified bid).
	measure 'Lowest Quoted Price' = MIN(fact_bid[quoted_price])
		formatString: $#,##0

	/// CBE: lowest normalized evaluated price among technically-qualified bids.
	measure 'Lowest Evaluated Price' = CALCULATE(MIN(fact_bid[evaluated_price]), fact_bid[is_technically_qualified] = TRUE())
		formatString: $#,##0

	/// CBE: evaluated price of the recommended award (lowest evaluated qualified bid).
	measure 'Recommended Evaluated Price' = CALCULATE(SUM(fact_bid[evaluated_price]), fact_bid[recommended] = TRUE())
		formatString: $#,##0

	/// CBE: quoted price of the recommended award.
	measure 'Recommended Quoted Price' = CALCULATE(SUM(fact_bid[quoted_price]), fact_bid[recommended] = TRUE())
		formatString: $#,##0

	/// CBE: supplier name of the recommended award in the current context (single RFQ).
	measure 'Recommended Supplier' = CALCULATE(SELECTEDVALUE(fact_bid[supplier_name]), fact_bid[recommended] = TRUE())

	/// CBE headline: recommended evaluated price minus the lowest quoted price — the cost of choosing the compliant, best-value bid over the cheapest quote.
	measure 'Evaluated vs Lowest Quote' = [Recommended Evaluated Price] - [Lowest Quoted Price]
		formatString: $#,##0

	column bid_id
		dataType: string
